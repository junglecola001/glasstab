{
  "manifest_version": 3,
  "name": "GlassTab",
  "version": "0.1.0",
  "description": "A liquid-glass personal workspace for your new tab page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "offline_enabled": true,
  "minimum_chrome_version": "111"
}
